<!-- features/{domaine}/components/item-list/item-list.html -->
<input
  class="w-full rounded-md border border-outline bg-surface px-3 py-2 text-on-surface"
  [ngModel]="searchTerm()"
  (ngModelChange)="searchTerm.set($event); currentPage.set(1)"
  [placeholder]="'common.search' | translate" />

@if (service.isLoading()) {
  <app-skeleton variant="list" />
} @else if (service.errorKey()) {
  <app-error-banner [messageKey]="service.errorKey()!" />
} @else {
  @for (item of page(); track item.id) {
    <div class="flex items-center justify-between border-b border-outline py-3">
      <span>{{ item.nom }}</span>
      <span class="bg-success/15 text-success px-2 py-0.5 rounded-sm text-xs font-semibold">
        {{ 'items.status.' + item.status | translate }}
      </span>
    </div>
  } @empty {
    <p>{{ 'common.empty' | translate }}</p>
  }

  <nav class="mt-4 flex items-center gap-2">
    <button type="button" class="px-3 py-1 rounded-md border border-outline disabled:opacity-50"
            [disabled]="currentPage() === 1" (click)="currentPage.set(currentPage() - 1)">
      {{ 'common.previous' | translate }}
    </button>
    <span>{{ currentPage() }} / {{ totalPages() }}</span>
    <button type="button" class="px-3 py-1 rounded-md border border-outline disabled:opacity-50"
            [disabled]="currentPage() === totalPages()" (click)="currentPage.set(currentPage() + 1)">
      {{ 'common.next' | translate }}
    </button>
  </nav>
}
