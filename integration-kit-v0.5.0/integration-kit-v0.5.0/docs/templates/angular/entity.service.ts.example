import { Injectable } from '@angular/core';
import { Observable } from 'rxjs';
import { CrudService } from '../../../shared/services/crud.service';
import { ApiResponse } from '../../../shared/models/api-response.model';
import { API_ENDPOINTS } from '../../../configurations/api-endpoints';
import { {PROJET}{Entite}BasicModel } from '../models/basic/{entite}-basic-model';
import { {PROJET}{Entite}FullModel } from '../models/full/{entite}-full-model';

// features/{domaine}/services/{entite}.service.ts
@Injectable({ providedIn: 'root' })
export class {PROJET}{Entite}Service extends CrudService<{PROJET}{Entite}BasicModel, {PROJET}{Entite}FullModel> {
  constructor() {
    super(API_ENDPOINTS.{entite}); // configurations/api-endpoints.ts : '/api/v1/{ressource}'
  }

  // Envoi multipart : seul l'appel HTTP est standardisé ; type, taille et
  // prévisualisation du fichier sont des règles propres au projet.
  createWithFile(payload: Omit<{PROJET}{Entite}FullModel, 'id'>, file: File): Observable<{PROJET}{Entite}FullModel> {
    const form = new FormData();
    form.append('file', file, file.name);
    form.append('dto', new Blob([JSON.stringify(payload)], { type: 'application/json' }));
    return this.call(this.http.post<ApiResponse<{PROJET}{Entite}FullModel>>(this.endpoint, form),
      item => this.patch({ items: [...this.items(), item] }));
  }
}
