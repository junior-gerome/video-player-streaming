# À ajouter dans .gitlab-ci.yml

# Variante 1 — runner Windows (shell PowerShell ou cmd)
check-standards:
  stage: test
  tags: [windows]
  script:
    - cmd /c "scripts\check-standards.bat ."
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
  # Phase d'observation sur un projet repris : décommenter la ligne suivante
  # allow_failure: true

# Variante 2 — runner Linux (Docker) : le même fichier .bat est exécuté par
# PowerShell 7, car tout son code utile est du PowerShell.
