# lombok.config — à placer à la racine du dépôt backend (au-dessus des modules)
# Voir docs/standards/BACKEND-SPRING-STANDARDS.md, section « Lombok ».
config.stopBubbling = true

# Code généré marqué @Generated : exclu de la couverture JaCoCo
lombok.addLombokGeneratedAnnotation = true

# FullDTO extends BasicDTO : equals/hashCode/toString incluent les champs du parent
lombok.equalsAndHashCode.callSuper = call
lombok.toString.callSuper = call

# Fonctions Lombok interdites dans le projet (erreur de compilation)
lombok.val.flagUsage = error
lombok.var.flagUsage = error
lombok.sneakyThrows.flagUsage = error
lombok.cleanup.flagUsage = error
lombok.synchronized.flagUsage = error
